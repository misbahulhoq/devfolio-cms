{
  "name": "devfolio-cms",
  "packageManager": "bun@1.3.12",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:client": "turbo -F=@devfolio-cms/client build",
    "build:api": "turbo -F=@devfolio-cms/api build",
    "test:api": "turbo -F=@devfolio-cms/api test",
    "test:client": "turbo -F=@devfolio-cms/client test"
  },
  "workspaces": [
    "api",
    "client",
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2.10.0"
  }
}
